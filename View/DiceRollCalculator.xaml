<UserControl x:Class="DMAssistant.View.DiceRollCalculator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DMAssistant.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="5" VerticalAlignment="Center">
            <TextBox x:Name="DiceCount" Margin="1" BorderThickness="1" MinWidth="36" Width="Auto" BorderBrush="Black"/>
            <ComboBox x:Name="DiceType" Margin="1"  MinWidth="48" Width="Auto" >
                <ComboBoxItem Content="d4"/>
                <ComboBoxItem Content="d6"/>
                <ComboBoxItem Content="d8"/>
                <ComboBoxItem Content="d10"/>
                <ComboBoxItem Content="d12"/>
                <ComboBoxItem Content="d20"/>
            </ComboBox>
            <TextBlock Text="+" FontSize="20" VerticalAlignment="Center"/>
            <TextBox x:Name="AdditionalValue" Margin="1" BorderThickness="1" MinWidth="36" Width="Auto" BorderBrush="Black"/>


        </StackPanel>
        
        <Button Click="Button_Click" Height="30" Width="90" HorizontalAlignment="Left" Margin="5" Content="Calculate"/>
        <TextBlock Margin="5" Height="24" x:Name="Output" Width="90" Background="White" HorizontalAlignment="Left" TextAlignment="Center"/>
    </StackPanel>
</UserControl>
