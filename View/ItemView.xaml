<UserControl x:Class="DMAssistant.View.ItemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DMAssistant.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <ScrollViewer>
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Name -->
            <TextBlock Text="Name:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
         Grid.Row="0" Grid.Column="1" Margin="0,5"/>

            <!-- Rank -->
            <TextBlock Text="Rank:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
            <ComboBox ItemsSource="{Binding AvailableRanks}"
          SelectedItem="{Binding Rank, UpdateSourceTrigger=PropertyChanged}"
          Grid.Row="1" Grid.Column="1" Margin="0,5"/>

            <!-- Type -->
            <TextBlock Text="Type:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
            <ComboBox ItemsSource="{Binding ItemTypes}"
            SelectedItem="{Binding Type, UpdateSourceTrigger=PropertyChanged}"
            Grid.Row="2" Grid.Column="1" Margin="0,5"/>
            
            <!-- Attunement -->
            <TextBlock Text="Requires Attunment:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="3" Grid.Column="1" SelectedValue="{Binding RequiresAttunement, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag">
                <ComboBoxItem Content="Requires Attunement" Tag="True"/>
                <ComboBoxItem Content="Does Not Require Attunement" Tag="False"/>
            </ComboBox>
            
            <!-- Function -->
            <TextBlock Text="Function:" Grid.Row="4" Grid.Column="0" VerticalAlignment="Top"/>
            <TextBox Text="{Binding Item.Function, UpdateSourceTrigger=PropertyChanged}"
         Grid.Row="4" Grid.Column="1" Margin="0,5" AcceptsReturn="True" Height="Auto" MinHeight="80" TextWrapping="Wrap"
         VerticalScrollBarVisibility="Auto"/>

            <!-- Appearance -->
            <TextBlock Text="Appearance:" Grid.Row="5" Grid.Column="0" VerticalAlignment="Top"/>
            <TextBox Text="{Binding Item.Appearance, UpdateSourceTrigger=PropertyChanged}"
         Grid.Row="5" Grid.Column="1" Margin="0,5" AcceptsReturn="True" Height="Auto" TextWrapping="Wrap"
         VerticalScrollBarVisibility="Auto"/>

            <!-- Origin -->
            <TextBlock Text="Origin:" Grid.Row="6" Grid.Column="0" VerticalAlignment="Top"/>
            <TextBox Text="{Binding Item.Origin, UpdateSourceTrigger=PropertyChanged}"
         Grid.Row="6" Grid.Column="1" Margin="0,5" AcceptsReturn="True" Height="Auto" TextWrapping="Wrap"
         VerticalScrollBarVisibility="Auto"/>

        </Grid>
    </ScrollViewer>

</UserControl>
