<Window x:Class="DMAssistant.View.SelectMonsterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:h="clr-namespace:DMAssistant.Helpers"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DMAssistant.View"
        mc:Ignorable="d"
        Title="Select Monster" SizeToContent="WidthAndHeight" MaxHeight ="700" WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBox x:Name="SearchTextBox"
                 Grid.Row="0"
                 Margin="0,0,0,10"
                 Width="250"
                 HorizontalAlignment="Left"
                 h:TextBoxHelper.Placeholder="Search..."
                 TextChanged="SearchTextBox_TextChanged" />

        <ListBox x:Name="MonsterListBox"
                 Grid.Row="1"
                 DisplayMemberPath="Name" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" Width="70" Margin="0,0,5,0" Click="Cancel_Click"/>
            <Button Content="Add" Width="70" Click="Add_Click"/>
        </StackPanel>
    </Grid>
</Window>
