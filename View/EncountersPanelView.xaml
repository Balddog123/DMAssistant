<UserControl x:Class="DMAssistant.View.EncountersPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DMAssistant.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <!-- Left side: encounter list -->
            <ColumnDefinition Width="175" />
            <!-- Right side: encounter details -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left panel -->
        <DockPanel Grid.Column="0">
            <!-- Add encounter button -->
            <Button Content="Add Encounter"
                    Command="{Binding AddEncounterCommand}"
                    Margin="5"
                    DockPanel.Dock="Top" />

            <!-- List of encounters -->
            <ListBox ItemsSource="{Binding Encounters}"
                     SelectedItem="{Binding SelectedEncounter}"
                     Margin="10"
                     DockPanel.Dock="Top">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <!-- Remove button -->
                            <Button Command="{Binding DataContext.RemoveEncounterCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}"
                                    DockPanel.Dock="Left">
                                <Image Width="16" Height="16" Source="pack://application:,,,/Resources/icon-delete.png"/>
                            </Button>
                            <Button Command="{Binding DataContext.DuplicateEncounter, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" DockPanel.Dock="Left">
                                <Image Width="16" Height="16" Source="pack://application:,,,/Resources/icon-copy.png"/>
                            </Button>

                            <!-- Encounter name -->
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Right panel: Encounter view gets injected here -->
        <Border Grid.Column="1">
            <ContentControl Content="{Binding SelectedEncounterViewModel}" />
        </Border>

    </Grid>
</UserControl>
