<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:DMAssistant.Helpers"
    xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
    xmlns:dd="urn:gong-wpf-dragdrop"
    xmlns:local="clr-namespace:DMAssistant.View"
    x:Class="DMAssistant.View.MapWindow"
    Title="" Height="800" Width="1200" Topmost="True" ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <ObjectDataProvider x:Key="GridLinesProvider"
                            MethodName="GetGridLines"
                            ObjectType="{x:Type helpers:GridHelper}" />
        <Style x:Key="IconButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderBrush" Value="Gray"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Window.CommandBindings>
        <CommandBinding Command="{x:Static local:MapWindow.DecreaseStrokeSizeCommand}" Executed="DecreaseStrokeSize_Executed"/>
        <CommandBinding Command="{x:Static local:MapWindow.IncreaseStrokeSizeCommand}" Executed="IncreaseStrokeSize_Executed"/>
    </Window.CommandBindings>

    <Window.InputBindings>
        <KeyBinding Key="OemOpenBrackets" Command="{x:Static local:MapWindow.DecreaseStrokeSizeCommand}" />
        <KeyBinding Key="OemCloseBrackets" Command="{x:Static local:MapWindow.IncreaseStrokeSizeCommand}" />
    </Window.InputBindings>

    <DockPanel>        

        <!-- Toolbar -->
        <ToolBarTray Background="White" DockPanel.Dock="Top" Orientation="Horizontal">
            <ToolBar>
                <Button Style="{StaticResource IconButtonStyle}" Click="SaveMap">
                    <Image Source="/Resources/icon-save.png"/>
                </Button>
            </ToolBar>
            <ToolBar x:Name="EditingTools" >
                <Button Style="{StaticResource IconButtonStyle}" Click="EnablePointer_Click">
                    <Image Source="/Resources/icon-pointer.png" />
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Click="EnableGridSnapping_Click">
                    <Image Source="/Resources/icon-edit.png"/>
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Click="DisableGridSnapping_Click">
                    <Image Source="/Resources/icon-editfree.png"/>
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Click="EnableErasing_Click">
                    <Image Source="/Resources/icon-erase.png"/>
                </Button>
                <xctk:ColorPicker SelectedColorChanged="ColorPicker_SelectedColorChanged" Width="50"/>
            </ToolBar>
            <ToolBar x:Name="Layers">
                <Button Style="{StaticResource IconButtonStyle}" Click="ToggleLayers_Click">
                    <Image Source="/Resources/icon-layers.png"/>
                </Button>
            </ToolBar>
            <ToolBar x:Name="AddItemTools">
                <Button Style="{StaticResource IconButtonStyle}" Click="DrawNoteButton_Click">
                    <Image Source="/Resources/icon-editnote.png"/>
                </Button>
            </ToolBar>
        </ToolBarTray>
        <Grid x:Name="LayerListPanel" DockPanel.Dock="Left" Margin="5" Width="300" Height="Auto" Background="SaddleBrown">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <ToolBarTray Grid.Row="0">
                <ToolBar>                    
                    <Button Style="{StaticResource IconButtonStyle}" Click="AddNewLayer_Click">
                        <Image Source="/Resources/icon-addtoplaylist.png"/>
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}" Click="MoveSelectedLayerDown_Click">
                        <Image Source="/Resources/icon-arrowDown.png"/>
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}" Click="MoveSelectedLayerUp_Click">
                        <Image Source="/Resources/icon-arrowUp.png"/>
                    </Button>
                    
                </ToolBar>
                <ToolBar>
                    <Button Style="{StaticResource IconButtonStyle}" Click="DeleteSelectedLayer_Click">
                        <Image Source="/Resources/icon-delete.png"/>
                    </Button>
                </ToolBar>
            </ToolBarTray>
            <StackPanel x:Name="LayerListContainer" Grid.Row="1">

            </StackPanel>
        </Grid>
        <!-- Scrollable Canvas / Layers -->
        <ScrollViewer DockPanel.Dock="Bottom" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
            <Grid Width="2000" Height="2000" x:Name="ZoomRoot">
                <Grid.LayoutTransform>
                    <ScaleTransform x:Name="ZoomTransform" ScaleX="1" ScaleY="1"/>
                </Grid.LayoutTransform>

                <!-- Dynamic layer container -->
                <Grid x:Name="LayerContainer" Width="2000" Height="2000" Background="Transparent"/>

                <!-- Background grid -->
                <Image Source="pack://application:,,,/DMAssistant;component/Resources/grid2000.png" IsHitTestVisible="False"/>

                <!-- Note boxes overlay -->
                <Canvas x:Name="NoteBoxes" Width="2000" Height="2000"/>
            </Grid>
        </ScrollViewer>

        
    </DockPanel>
</Window>
