<UserControl x:Class="DMAssistant.View.NPCView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <DockPanel Margin="5">
        <Grid DockPanel.Dock="Top" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto" MinHeight="60"/>
                <RowDefinition Height="Auto" MinHeight="60"/>
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Name -->
            <TextBlock Text="Name:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
            <Button Grid.Row="0" Grid.Column="1" Margin="5" Height="30" Width="30" Command="{Binding RandomizeNameCommand}">
                <Image Source="/Resources/icon-refresh.png"/>
            </Button>
            <TextBox Text="{Binding NPC.Name, UpdateSourceTrigger=PropertyChanged}" 
Grid.Row="0" Grid.Column="2" Margin="0,5"/>

            <!-- Gender -->
            <TextBlock Text="Gender:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
            <ComboBox SelectedValue="{Binding NPC.Gender, UpdateSourceTrigger=PropertyChanged}" 
         SelectedValuePath="Content"
         Grid.Row="1" Grid.Column="2" Margin="0,5" >
                <ComboBoxItem Content="Male"/>
                <ComboBoxItem Content="Female"/>
            </ComboBox>

            <!-- Race -->
            <TextBlock Text="Race:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
            <Button Grid.Row="2" Grid.Column="1" Margin="5" Height="30" Width="30" Command="{Binding RandomizeRaceCommand}">
                <Image Source="/Resources/icon-refresh.png"/>
            </Button>
            <ComboBox ItemsSource="{Binding AvailableRaces}" 
 SelectedItem="{Binding NPC.Race, UpdateSourceTrigger=PropertyChanged}" 
 Grid.Row="2" Grid.Column="2" Margin="0,5" />

            <!-- Description -->
            <TextBlock Text="Description:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Top" Margin="0,5"/>
            <Button Grid.Row="3" Grid.Column="1" Margin="5" Height="30" Width="30" Command="{Binding RandomizeDescriptionCommand}">
                <Image Source="/Resources/icon-refresh.png"/>
            </Button>
            <TextBox Text="{Binding NPC.Description, UpdateSourceTrigger=PropertyChanged}" 
Grid.Row="3" Grid.Column="2" Margin="0,5" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>

            <!-- Goal -->
            <TextBlock Text="Goal:" Grid.Row="4" Grid.Column="0" VerticalAlignment="Top" Margin="0,5"/>
            <Button Grid.Row="4" Grid.Column="1" Margin="5" Height="30" Width="30" Command="{Binding RandomizeGoalCommand}">
                <Image Source="/Resources/icon-refresh.png"/>
            </Button>
            <TextBox Text="{Binding NPC.Goal, UpdateSourceTrigger=PropertyChanged}" 
Grid.Row="4" Grid.Column="2" Margin="0,5" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"  Height="Auto" TextWrapping="Wrap"/>

            <!-- Home -->
            <TextBlock Text="Home:" Grid.Row="5" Grid.Column="0" VerticalAlignment="Top" Margin="0,5"/>
            <Button Grid.Row="5" Grid.Column="1" Margin="5" Height="30" Width="30" Command="{Binding RandomizeHomeCommand}">
                <Image Source="/Resources/icon-refresh.png"/>
            </Button>
            <ComboBox   ItemsSource="{Binding AvailableLocations}" SelectedValue="{Binding NPC.Home, UpdateSourceTrigger=PropertyChanged}"
           SelectedValuePath="" Grid.Row="5" Grid.Column="2" Margin="0,5" >
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name, TargetNullValue='(None)'}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

    </DockPanel>
    
</UserControl>
