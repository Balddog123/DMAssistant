<UserControl
    x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:h="clr-namespace:DMAssistant.Helpers.Converter"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" x:Class="DMAssistant.View.MapTextBox"
             av:DesignWidth="256.915" Height="104" >
    <UserControl.Resources>
        <h:BoolToBorderThicknessConverter x:Key="BoolToBorderThicknessConverter"/>
    </UserControl.Resources>
    <Border BorderBrush="Black" BorderThickness="{Binding IsSelected, ElementName=Root, Converter={StaticResource BoolToBorderThicknessConverter}}" Background="Transparent" >
        <Grid Background="Transparent" >
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Viewbox Stretch="Uniform" Grid.Row="0" Grid.RowSpan="2" Margin="10">
                <TextBox  VerticalAlignment="Center" HorizontalAlignment="Center" x:Name="MainTextBox" Text="New Text Box" BorderThickness="0" Background="Transparent"  FontWeight="Bold" IsReadOnly="True" Focusable="False" MouseDoubleClick="TextBox_MouseDoubleClick" />
            </Viewbox>


            <Button  HorizontalAlignment="Right" VerticalAlignment="Top" Width="16" Height="16" Background="Red" Foreground="White" Click="DeleteButton_Click" Visibility="{Binding IsSelected, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Image Source="/Resources/icon-close.png" />
            </Button>

            <Rectangle Grid.Row="1" Margin="0,0,-2,-2" x:Name="BottomRightHandle" 
               Width="10" Height="10" Fill="White" Stroke="Gray" 
               HorizontalAlignment="Right" VerticalAlignment="Bottom" 
               Visibility="{Binding IsSelected, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}"
               Cursor="SizeNWSE"/>
        </Grid>
    </Border>
    
</UserControl>
