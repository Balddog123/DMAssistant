<mah:MetroWindow    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                    x:Class="DMAssistant.View.MainWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:local="clr-namespace:DMAssistant"
                    xmlns:vm="clr-namespace:DMAssistant.ViewModel"
                    mc:Ignorable="d"
                    ResizeMode="CanResizeWithGrip"
                    Title="{Binding CampaignName}">
    <Window.InputBindings>
        <KeyBinding Modifiers="Ctrl" Key="S" Command="{Binding SaveCampaign}"/>
    </Window.InputBindings>

    <DockPanel Background="#F4ECDC">
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New" Command="{Binding NewCampaign}"/>
                <MenuItem Header="_Save" Command="{Binding SaveCampaign}"/>
                <MenuItem Header="_Open" Command="{Binding OpenCampaign}"/>
                <Separator/>
                <MenuItem Header="_Exit" Command="{Binding Exit}"/>
            </MenuItem>
            <MenuItem Header="_Settings">
                <MenuItem Header="_Reset Monsters" Command="{Binding ResetMonsters}"/>
                <MenuItem Header="_Add SRD Items" Command="{Binding AddSRDItemsCommand}"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About (Placeholder)" />
            </MenuItem>
        </Menu>
        <!-- ######## TOP BAR WITH CIRCLE BUTTONS ######## -->
        <StackPanel DockPanel.Dock="Top"
                    Orientation="Horizontal"
                    Margin="2"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Panel.ZIndex="10">
            <!-- Campaign Button -->
            <Button Command="{Binding ShowCampaignCommand}"
                    Width="40">
                <Image Source="pack://application:,,,/Resources/icon-book.png"/>
            </Button>

            <!-- Sessions Button -->
            <Button Command="{Binding ShowSessionsCommand}"
                    Width="40"
                    Margin="10 0 0 0">
                <Image Source="pack://application:,,,/Resources/icon-page.png"/>
            </Button>

            <!-- SoundPanel Button -->
            <Button Command="{Binding ShowSoundPanelCommand}"
                    Width="40"
                    Margin="10 0 0 0">
                <Image Source="pack://application:,,,/Resources/icon-sound.png"/>
            </Button>
            <MediaElement x:Name="GlobalMediaPlayer"
                            LoadedBehavior="Manual"
                            UnloadedBehavior="Manual"
                            MediaOpened="Player_MediaOpened"
                            MediaEnded="Player_MediaEnded" Visibility="Collapsed" />
            <MediaElement x:Name="GlobalAmbiencePlayer"
                LoadedBehavior="Manual"
                UnloadedBehavior="Manual"
                MediaOpened="Player_MediaOpened"
                MediaEnded="Player_MediaEnded" Visibility="Collapsed" />
            <MediaElement x:Name="GlobalSoundPlayer"
                LoadedBehavior="Manual"
                UnloadedBehavior="Manual"
                MediaOpened="Player_MediaOpened"
                MediaEnded="Player_MediaEnded" Visibility="Collapsed" />
        </StackPanel>

        <!-- ######## MAIN CONTENT AREA ######## -->
        <Grid DockPanel.Dock="Left">    
            <!-- CampaignView user control goes here!-->
            <ContentControl x:Name="MainContent" Content="{Binding CurrentView}" Margin="2"/>
        </Grid>

    </DockPanel>

</mah:MetroWindow>


