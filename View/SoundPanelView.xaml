<UserControl x:Class="DMAssistant.View.SoundPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DMAssistant.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <TabControl>
        <TabItem Header="Music">
            <local:SoundView DataContext="{Binding MusicSoundView}"/>
        </TabItem>
        <TabItem Header="Ambience">
            <local:SoundView DataContext="{Binding AmbienceSoundView}"/>
        </TabItem>
        <TabItem Header="Sound">
            <local:SoundView DataContext="{Binding SoundboardSoundView}"/>
        </TabItem>
    </TabControl>
    
</UserControl>
