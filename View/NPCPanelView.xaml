<UserControl x:Class="DMAssistant.View.NPCPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:v="clr-namespace:DMAssistant.View"
             xmlns:h="clr-namespace:DMAssistant.Helpers.Converter"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <h:BoolToAsteriskConverter x:Key="BoolToAsteriskConverter"/>
    </UserControl.Resources>

    <Grid Margin="5">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MaxWidth="750" MinWidth="220"/>
            <!-- left list -->
            <ColumnDefinition Width="*"/>
            <!-- right details -->
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Add New NPC -->
        <Button Grid.Row="0" Content="New NPC"
            Command="{Binding AddNPCCommand}"
            Margin="5"/>
        <!-- Add Existing NPC -->
        <Button Grid.Row="1" Content="Add Existing NPC"
            Command="{Binding AddExistingNPCCommand}"
            Margin="5"/>

        <TextBlock Grid.Row="2" Text="NPCs" FontWeight="Bold" Margin="0,0,0,5"/>

        <ListView Grid.Row="3"
          ItemsSource="{Binding NPCsView}"
          SelectedItem="{Binding SelectedNPC}"
          Name="NPCListView"
          PreviewMouseDown="NPCListView_PreviewMouseDown">

            <ListView.View>
                <GridView AllowsColumnReorder="True">

                    <!-- Buttons column -->
                    <GridViewColumn Header="Actions" Width="Auto">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Command="{Binding DataContext.DeleteNPC,
                                              RelativeSource={RelativeSource AncestorType=ListView}}"
                                    CommandParameter="{Binding}"
                                    Margin="2">
                                        <Image Width="16" Height="16"
                                       Source="pack://application:,,,/Resources/icon-delete.png"/>
                                    </Button>

                                    <Button Command="{Binding DataContext.DuplicateNPC,
                                              RelativeSource={RelativeSource AncestorType=ListView}}"
                                    CommandParameter="{Binding}"
                                    Margin="2">
                                        <Image Width="16" Height="16"
                                       Source="pack://application:,,,/Resources/icon-copy.png"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- Name column -->
                    <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="300" />

                    <!-- Home.Name column -->
                    <GridViewColumn Header="Home"
                            DisplayMemberBinding="{Binding Home.Name}"/>

                </GridView>
            </ListView.View>
        </ListView>



        <!-- ================= RIGHT SIDE (NPC Detail View) ================= -->
        <ContentControl Grid.Column="1" Grid.RowSpan="4" Content="{Binding SelectedNPCViewModel}" />

    </Grid>
</UserControl>
