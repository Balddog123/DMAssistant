<UserControl x:Class="DMAssistant.View.EncounterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:h="clr-namespace:DMAssistant.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Encounter Name Field -->
        <TextBox Grid.Row="0"
                 Text="{Binding Name, Mode=TwoWay}"
                 FontSize="20"
                 FontWeight="Bold"
                 Margin="0 0 0 5" />

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Left side: Encounter Items -->
                <ColumnDefinition Width="Auto" />
                <!-- Right side: Tracker + Item Details -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="20"/>
                <RowDefinition Height="0.5*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Encounter Details -->
            <Border Grid.Column="0" Grid.Row="0" BorderThickness="1" Background="#EFE3C7">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Total CR:" FontWeight="Bold" />
                        <TextBlock Text="{Binding TotalCR}" />
                    </StackPanel>
                    <StackPanel Margin="5,0,0,0" Orientation="Horizontal">
                        <TextBlock Text="Total XP:" FontWeight="Bold"/>
                        <TextBlock Text="{Binding TotalXP}"/>
                        <TextBlock Text=" / "/>
                        <TextBlock Text="{Binding TotalXPAvailable}"/>
                    </StackPanel>
                    <StackPanel Margin="5,0,0,0" Orientation="Horizontal">
                        <TextBlock Text="Difficulty:" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Difficulty}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            
                <!-- List of Encounter Items -->
            <Grid Grid.Column="0" Grid.Row="1">
                <Grid.RowDefinitions>
                    <!-- Buttons -->
                    <RowDefinition Height="Auto" />
                    <!-- Encounter Item list -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0">
                    <Button Content="Add Monster" Margin="0,0,1,0" Command="{Binding AddMonsterCommand}"></Button>
                    <Button Content="Add Event" Margin="1,0,0,0" Command="{Binding AddEventCommand}"></Button>
                    <Button Content="Run!" Margin="1,0,0,0" Command="{Binding RunEncounterCommand}"></Button>
                </DockPanel>
                
                <!-- EncounterItems list -->
                <ListView Grid.Row="1" ItemsSource="{Binding EncounterItems}" SelectedItem="{Binding SelectedItem}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Name" Width="200" DisplayMemberBinding="{Binding Name}" />
                            <GridViewColumn Header="#" Width="50" DisplayMemberBinding="{Binding Quantity}" />
                            <GridViewColumn Header="CR" Width="50" DisplayMemberBinding="{Binding CR}" />
                            <GridViewColumn Header="Round#" Width="60" DisplayMemberBinding="{Binding RoundNumber}" />
                            <GridViewColumn Header="Type" Width="50" DisplayMemberBinding="{Binding TypeName}" />
                            <GridViewColumn Header="Ally" Width="50" DisplayMemberBinding="{Binding IsAlly}" />
                            <GridViewColumn Header="" Width="40">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}">
                                            <Image Width="16" Height="16" Source="pack://application:,,,/Resources/icon-delete.png"/>
                                        </Button>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>

            <!-- Combat Tracker control placeholder -->
            <Border Grid.Column="0" Grid.Row="2">
                <ContentControl Content="{Binding CurrentCombat}" />
            </Border>

            <!-- Monster View -->
            <Border Grid.Column="1" Grid.Row="1" Grid.RowSpan="2" Margin="2, 0, 0, 0" BorderThickness="2">
                <ScrollViewer VerticalScrollBarVisibility="Auto" h:ScrollViewerUtilities.BubbleMouseWheel="True">
                    <ContentControl Content="{Binding SelectedItem}" />
                </ScrollViewer>
            </Border>
            

        </Grid>

    </Grid>

</UserControl>
