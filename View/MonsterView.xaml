<UserControl x:Class="DMAssistant.View.MonsterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DMAssistant.View"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="800">
    <StackPanel Margin="10">

        <TextBox Text="{Binding Name, Mode=TwoWay}" FontSize="26" FontWeight="Bold"/>

        <TextBox Text="{Binding Meta, Mode=TwoWay}" FontStyle="Italic" Margin="0,0,0,10"/>

        <StackPanel Orientation="Horizontal">
            <StackPanel Margin="2">
                <TextBlock Text="Challenge:" FontWeight="Bold"/>
                <TextBox Text="{Binding Challenge, Mode=TwoWay}" Margin="0,0,0,10"/>
            </StackPanel>
            <StackPanel Margin="2">
                <TextBlock Text="Armor Class:" FontWeight="Bold"/>
                <TextBox Text="{Binding ArmorClass, Mode=TwoWay}" Margin="0,0,0,10"/>
            </StackPanel>
            <StackPanel Margin="2">
                <TextBlock Text="Hit Points:" FontWeight="Bold"/>
                <TextBox Text="{Binding HitPoints, Mode=TwoWay}" Margin="0,0,0,10"/>
            </StackPanel>
            <StackPanel Margin="2">
                <TextBlock Text="Speed:" FontWeight="Bold"/>
                <TextBox Text="{Binding Speed, Mode=TwoWay}" Margin="0,0,0,10"/>
            </StackPanel>
        </StackPanel>
        <Separator Margin="10" Width="500"/>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock  Grid.Row="0" Grid.Column="0" Margin="3" Text="STR:" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBox  Grid.Row="0" Grid.Column="1" Margin="3" Text="{Binding STR, Mode=TwoWay}" MinWidth="30"/>
            <TextBlock  Grid.Row="0" Grid.Column="2" Margin="3" Text="{Binding STR_Mod}" TextAlignment="Center" VerticalAlignment="Center" Background="LightGray"/>

            <TextBlock  Grid.Row="0" Grid.Column="3" Margin="3" Text="DEX:" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBox  Grid.Row="0" Grid.Column="4" Margin="3" Text="{Binding DEX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinWidth="30"/>
            <TextBlock  Grid.Row="0" Grid.Column="5" Margin="3" Text="{Binding DEX_Mod}" TextAlignment="Center" VerticalAlignment="Center" Background="LightGray"/>

            <TextBlock  Grid.Row="0" Grid.Column="6" Margin="3" Text="CON:" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBox  Grid.Row="0" Grid.Column="7" Margin="3" Text="{Binding CON, Mode=TwoWay}" MinWidth="30"/>
            <TextBlock  Grid.Row="0"  Grid.Column="8" Margin="3" Text="{Binding CON_Mod}" TextAlignment="Center" VerticalAlignment="Center" Background="LightGray"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Margin="3" Text="INT:" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBox Grid.Row="1" Grid.Column="1" Margin="3" Text="{Binding INT, Mode=TwoWay}" MinWidth="30"/>
            <TextBlock Grid.Row="1" Grid.Column="2" Margin="3" Text="{Binding INT_Mod}" TextAlignment="Center" VerticalAlignment="Center" Background="LightGray"/>

            <TextBlock Grid.Row="1" Grid.Column="3" Margin="3" Text="WIS:" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBox Grid.Row="1" Grid.Column="4" Margin="3" Text="{Binding WIS, Mode=TwoWay}" />
            <TextBlock Grid.Row="1" Grid.Column="5" Margin="3" Text="{Binding WIS_Mod}" TextAlignment="Center" VerticalAlignment="Center" Background="LightGray"/>

            <TextBlock Grid.Row="1" Grid.Column="6" Margin="3" Text="CHA:" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBox Grid.Row="1" Grid.Column="7" Margin="3" Text="{Binding CHA, Mode=TwoWay}" />
            <TextBlock Grid.Row="1" Grid.Column="8" Margin="3" Text="{Binding CHA_Mod}" TextAlignment="Center" VerticalAlignment="Center" Background="LightGray"/>
        </Grid>
        <TextBlock Text="Saving Throws:" FontWeight="Bold"/>
        <TextBox Text="{Binding Monster.SavingThrows, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap"/>
        <TextBlock Text="Skills:" FontWeight="Bold"/>
        <TextBox Text="{Binding Monster.Skills, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap"/>
        <Separator Margin="10" Width="500"/>

        <TextBlock Text="Damage Resistances:" FontWeight="Bold"/>
        <TextBox Text="{Binding Monster.DamageResistances, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap"/>
        <TextBlock Text="Damage Immunities:" FontWeight="Bold"/>
        <TextBox Text="{Binding Monster.DamageImmunities, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap"/>
        <TextBlock Text="Condition Immunities:" FontWeight="Bold"/>
        <TextBox Text="{Binding Monster.ConditionImmunities, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap"/>

        <Separator Margin="10" Width="500"/>
        <TextBlock Text="Traits:" FontWeight="Bold"/>
        <TextBox Text="{Binding TraitsText, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap"/>

        <TextBlock Text="Actions:" FontWeight="Bold"/>
        <TextBox Text="{Binding ActionsText, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap"/>

        <TextBlock Text="Legendary Actions:" FontWeight="Bold"/>
        <TextBox Text="{Binding LegendaryText, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap"/>
    </StackPanel>
</UserControl>
