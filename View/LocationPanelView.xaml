<UserControl x:Class="DMAssistant.View.LocationPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ROWS FOR LEFT COLUMN -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- LEFT COLUMN CONTROLS -->
        <Button Grid.Column="0" Grid.Row="0"
                Content="New Location"
                Command="{Binding AddLocationCommand}"
                Margin="0,0,10,10"/>

        <Button Grid.Column="0" Grid.Row="1"
                Content="Add Existing Location"
                Command="{Binding AddExistingLocationCommand}"
                Margin="0,0,10,10"/>

        <TextBlock Grid.Column="0" Grid.Row="2"
                   Text="Locations"
                   FontWeight="Bold"
                   Margin="0,0,10,5"/>

        <ListBox Grid.Column="0" Grid.Row="3"
                 ItemsSource="{Binding LocationList}"
                 SelectedItem="{Binding SelectedLocation}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel>
                        <Button Command="{Binding DataContext.DeleteLocation, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}"
                                DockPanel.Dock="Left">
                            <Image Width="16"
                                   Height="16"
                                   Source="pack://application:,,,/Resources/icon-delete.png"/>
                        </Button>

                        <TextBlock Text="{Binding Name}"  DockPanel.Dock="Right" VerticalAlignment="Center" Margin="5"/>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- RIGHT SIDE -->
        <Border Grid.Column="1" Grid.Row="0" Grid.RowSpan="4" BorderThickness="1" Margin="2">
            <ContentControl Content="{Binding SelectedLocationViewModel}" />
        </Border>
        
    </Grid>
</UserControl>
