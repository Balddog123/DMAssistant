<UserControl x:Class="DMAssistant.View.LocationPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DMAssistant.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="10">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <!-- item list -->
            <ColumnDefinition Width="*"/>
            <!-- detail view -->
        </Grid.ColumnDefinitions>

        <!-- LEFT: Item List + Add Button -->
        <StackPanel Grid.Column="0">

            <Button Content="New Location" Command="{Binding AddLocationCommand}" Margin="0,0,0,10"/>
            <Button Content="Add Existing Location" Command="{Binding AddExistingLocationCommand}" Margin="0,0,0,10"/>

            <TextBlock Text="Locations" FontWeight="Bold" Margin="0,0,0,5"/>

            <ListBox    ItemsSource="{Binding LocationList}"
                        SelectedItem="{Binding SelectedLocation}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <!-- Remove button -->
                            <Button Command="{Binding DataContext.DeleteLocation, RelativeSource={RelativeSource AncestorType=ListBox}}"
                        CommandParameter="{Binding}"
                        Margin="0,0,0,0"
                        DockPanel.Dock="Right">
                                <Image Width="16" Height="16" Source="pack://application:,,,/Resources/icon-delete.png"/>
                            </Button>
                            <TextBlock Text="{Binding Name}" />
                        </DockPanel>

                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

        </StackPanel>

        <!-- RIGHT: Item Detail View -->
        <ContentControl Grid.Column="1"
                    Content="{Binding SelectedLocationViewModel}" />

    </Grid>
</UserControl>
